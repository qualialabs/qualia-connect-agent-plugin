{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qualia-connect": {
      "type": "streamable-http",
      "url": "https://connect.qualia.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": [
              "orders:read",
              "documents:read",
              "profile:read",
              "messages:write",
              "feedback:write",
              "orders:write"
            ]
          }
        }
      }
    }
  }
}
